{
  "info": {
    "name": "EnumConnect API",
    "description": "Backend tests for auth v2 and /api/me. Synthetic data only. Folder 1 needs no account. Run folders in order; Postman's cookie jar carries the session.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Rejected requests (no session needed)",
      "item": [
        {
          "name": "GET /api/me without a session -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me"
              ]
            },
            "description": "Run first, before logging in, or clear the cookie jar."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 when not logged in', () => pm.response.to.have.status(401));",
                  "pm.test('generic error body', () => pm.expect(pm.response.json().error).to.eql('Not authenticated'));",
                  "pm.test('response is not cacheable', () => pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'));"
                ]
              }
            }
          ]
        },
        {
