                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            },
            "description": "Use a real inbox you control. Password must be 8+ characters with a number.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"researcher\",\n  \"fullName\": \"Test Researcher\",\n  \"acceptedTerms\": true\n}",
