          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 on valid login', () => pm.response.to.have.status(200));",
                  "pm.test('session cookie is set', () => pm.expect(pm.response.headers.has('Set-Cookie')).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/me -> own profile and verification flags",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with a session', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const p = body.profile;",
                  "pm.test('profile has the expected fields', () => { pm.expect(p).to.have.all.keys('id','role','account_status','full_name'); });",
                  "pm.test('role is a valid account type', () => pm.expect(['researcher','enumerator','staff']).to.include(p.role));",
                  "pm.test('account is active', () => pm.expect(p.account_status).to.eql('active'));",
                  "pm.test('email shows as verified', () => pm.expect(body.verification.email).to.be.true);",
                  "pm.test('verification block has a phone flag', () => pm.expect(body.verification).to.have.property('phone'));",
                  "pm.test('response is not cacheable', () => pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'));"
                ]
              }
            }
          ]
        },
